# ── Boomerang configuration ─────────────────────────────────────────────
# Copy to .env (gitignored). Everything has a safe default — with no key at
# all the app runs end-to-end in mock voice mode.

# ── Voice provider ──
# "assemblyai" | "mock". Defaults to assemblyai when a key is present.
VOICE_PROVIDER=mock

# AssemblyAI API key — server-side only, NEVER commit the real value.
# Get one at https://www.assemblyai.com/dashboard (manual signup step).
ASSEMBLYAI_API_KEY=

# Voice Agent API endpoint (default: wss://agents.assemblyai.com/v1/ws)
AAI_VOICE_AGENT_WSS=wss://agents.assemblyai.com/v1/ws

# Agent voice (default: alba)
AAI_VOICE=alba

# ── AssemblyAI session tuning (see docs/assemblyai-dropin.md) ──
# Turn detection: one-word approvals ("ship it") need a short min_silence.
AAI_MIN_SILENCE_MS=400
AAI_MAX_SILENCE_MS=1200
# Barge-in: user can interrupt the agent mid-summary.
AAI_INTERRUPT_RESPONSE=true
# Extra keyterms merged into every session (comma-separated) — repo jargon
# that generic STT mangles. Per-session terms (branch, file names) add on top.
AAI_EXTRA_KEYTERMS=
# Browser mic format for input.audio frames: PCM16 mono at this rate.
AAI_SAMPLE_RATE=24000

# ── Worker / demo target ──
# GitHub repo the worker fixes bugs in (owner/name)
DEMO_REPO=Abhinav-Prabhakar/boomerang-demo-target

# Local workspace for clones (gitignored)
WORK_DIR=./work

# Persistent store: tasks.json + receipts.jsonl live here (gitignored —
# receipts are runtime demo artifacts, not source)
DATA_DIR=./data

# ── Server ──
PORT=8787
